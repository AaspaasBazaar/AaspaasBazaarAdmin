# Firebase project — matches the web config you shared
FIREBASE_PROJECT_ID=aaspaasbazaar

# --- Firebase Admin SDK service-account (PRODUCTION) ---
# Get these three from a service-account JSON downloaded from
# Firebase console → Project Settings → Service Accounts → "Generate new private key"
# When ALL THREE are set, Firestore is used as the primary store.
# When unset, the app falls back to local db.json for dev.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Storage mode override ---
# Set STORAGE_MODE=json to force local db.json mode (even if Admin creds present).
# Set STORAGE_MODE=firestore to require Firestore (errors if creds missing).
# Leave empty for auto-detect.
STORAGE_MODE=

# Vercel Cron secret — guards POST /api/cron/simulate-order
CRON_SECRET=replace-with-openssl-rand-hex-32
