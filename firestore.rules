rules_version = '2';

// AaspaasBazaar — Firestore Security Rules
//
// ARCHITECTURE: the Next.js backend is the ONLY writer. It uses the Firebase
// Admin SDK (service account), which bypasses these rules entirely. Therefore
// every client-facing path defaults to DENY. User + vendor apps read and write
// through the backend API (/api/app/*), never Firestore directly.
//
// EXCEPTION: collections that need real-time push (live order tracking, new-order
// pings) get a narrow, auth-scoped, READ-ONLY carve-out below. Writes stay
// backend-only everywhere — there is no client write rule anywhere in this file.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function signedIn() {
      return request.auth != null;
    }
    function hasRole(r) {
      return signedIn() && request.auth.token.role == r;
    }

    // ---- realtime carve-outs (READ-ONLY, auth-scoped) ----

    // A customer may watch the live status of their OWN orders.
    // Requires orders to carry a `user_id` == the customer's Firebase uid.
    match /orders/{orderId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false; // backend (Admin SDK) only
    }

    // A vendor may watch incoming orders for their OWN vendor id.
    // Requires a `vendor_id` custom claim on the vendor account.
    match /vendor_feed/{vendorId} {
      allow read: if hasRole('vendor')
                  && request.auth.token.vendor_id == resource.data.vendor_id;
      allow write: if false; // backend (Admin SDK) only
    }

    // ---- everything else: deny all client access ----
    // vendors, items, categories, zones, admins, settings, config, users, ...
    // All reads/writes for these go through the backend API.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
